NODE_ENV=development
PORT=5001

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5434/DATABASE_NAME?schema=public"

JWT_SECRET=your-jwt-access-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_TOKEN_SECRET=your-jwt-refresh-secret
JWT_REFRESH_TOKEN_EXPIRES_IN=7d
JWT_RESET_PASS_TOKEN=your-jwt-reset-secret
JWT_RESET_PASS_TOKEN_EXPIRES_IN=10m

ADMIN_EMAIL=emtiaz2060@gmail.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Emtiaz Ahmed

# SMTP — Gmail (use App Password, not your real password)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password

# CORS — comma-separated client origins for production
# e.g. CORS_ORIGINS=https://emtiaz-client.vercel.app,https://emtiazahmed.com
CORS_ORIGINS=
